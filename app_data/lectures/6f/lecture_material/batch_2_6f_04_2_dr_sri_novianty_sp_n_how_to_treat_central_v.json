          "type": "Paragraph",
          "text": "Rehabilitasi.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 170
          }
        },
        {
          "type": "Paragraph",
          "text": "Dilakukan setelah penyakit yang mendasarinya sudah ditanggulangi sehingga tidak lagi menimbulkan masalah kesehatan yang perlu diterapi segera.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 171
          }
        },
        {
          "type": "Paragraph",
          "text": "Tujuan rehabilitasi: .",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 172
          }
        },
        {
          "type": "Paragraph",
          "text": "Meningkatkan stabilitas gaze.",
