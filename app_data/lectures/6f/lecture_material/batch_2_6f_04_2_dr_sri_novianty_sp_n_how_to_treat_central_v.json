    {
      "id": "batch_2_6f_04_s12",
      "title": "Vertigo Sentral",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "BuSkaingminerjuapiakan penyakit tersendiri, tetapi merupakan gejala dari etiologi lain yang.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 61
          }
        },
        {
          "type": "Paragraph",
          "text": "Terkait sistem vestibuler sentral yang dapat mengenai otak: .",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 62
          }
        },
        {
          "type": "Paragraph",
          "text": "Onset akut.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 63
          }
        },
        {
          "type": "Paragraph",
          "text": "Vaskular: Stroke, TIA.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 64
          }
        },
        {
          "type": "Paragraph",
          "text": "Post-traumatic: diffuse axonal injury.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 65
          }
        },
        {
          "type": "Paragraph",
          "text": "Onset subakut, kronis, atau episodik.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 66
          }
        },
        {
          "type": "Paragraph",
          "text": "Infiamasi/ Infeksi: multiple sklerosis.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 67
          }
        },
        {
          "type": "Paragraph",
          "text": "Tumor: Neuroma Akustikus, Medulloblastoma.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 68
          }
        },
        {
          "type": "Paragraph",
          "text": "Epilepsi.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 69
          }
        },
        {
          "type": "Paragraph",
          "text": "Migraine Assosiate Dizziness.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 70
          }
        },
        {
          "type": "Paragraph",
          "text": "Manifestasi Klinis Vertigo sentral Berdasarkan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 71
          }
        },
        {
          "type": "Paragraph",
          "text": "Penyebabnya.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 72
          }
        },
        {
          "type": "Paragraph",
          "text": "Multiple Sklerosis.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 73
          }
        },
        {
          "type": "Paragraph",
          "text": "Diagnosis MS ini ditegakkan secara klinis dan tidak ada satupun pemeriksaan definitif dan memerlukan pemeriksaan neurologis dan pengamatan klinis dalam kurun waktu tertentu.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 74
          }
