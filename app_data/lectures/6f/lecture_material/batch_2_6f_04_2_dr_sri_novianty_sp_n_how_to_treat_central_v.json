    {
      "id": "batch_2_6f_04_high_yield",
      "title": "High-yield / titik ujian dari sumber.",
      "kind": "Callout",
      "content": [
        {
          "type": "Callout",
          "variant": "Exam_focus",
          "title": "Fokus belajar",
          "text": "BuSkaingminerjuapiakan penyakit tersendiri, tetapi merupakan gejala dari etiologi lain yang."
        },
        {
          "type": "Callout",
          "variant": "Exam_focus",
          "title": "Fokus belajar",
          "text": "Diagnosis MS ini ditegakkan secara klinis dan tidak ada satupun pemeriksaan definitif dan memerlukan pemeriksaan neurologis dan pengamatan klinis dalam kurun waktu tertentu."
        },
        {
          "type": "Callout",
          "variant": "Exam_focus",
          "title": "Fokus belajar",
          "text": "Tatalaksana berupa kortikosteroid daan interferon untuk kasus yang relaps."
        },
        {
          "type": "Callout",
          "variant": "Exam_focus",
          "title": "Fokus belajar",
          "text": "Gejala utama: Gejala auditoris berupa kehilangan pendengaran unilateral, gejala vestibular dan gejala gangguan nervus kranialis juga terjadi berupa disekuibilirium, Mati rasa, nyeri wajah, sakit kepala, Penurunan pengl…."
        },
        {
          "type": "Callout",
          "variant": "Exam_focus",
          "title": "Fokus belajar",
          "text": "Terapi tatalaksana utama tumor CPA adalah pembedahan."
        },
        {
          "type": "Callout",
          "variant": "Exam_focus",
          "title": "Fokus belajar",
          "text": "Bisa dilakukan dalam tiga kategori yaitu observasi/konservatif, radioterapi/stereotatic radiosurgery dan bedah mikro."
        },
        {
          "type": "Callout",
          "variant": "Exam_focus",
          "title": "Fokus belajar",
          "text": "Prognosisnya sangat tergantung pada seberapa besar tumor dan beratnya gejala neurologis yang ada saat."
        },
        {
          "type": "Callout",
          "variant": "Exam_focus",
          "title": "Fokus belajar",
          "text": "Ditegakkan dan dimulainya tatalaksana."
        }
      ],
