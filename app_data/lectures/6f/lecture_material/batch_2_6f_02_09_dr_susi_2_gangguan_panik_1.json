    {
      "id": "batch_2_6f_02_s05",
      "title": "TANDA dan GEJALA",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "Serangan panik yang berulang, terjadi secara spontan dan tidak terduga. Disertai gejala otonomik yang kuat, terutama pada sistem kardiovaskular dan pernapasan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 21
          }
        },
        {
          "type": "Paragraph",
          "text": "Serangan sering dimulai selama 10 menit dan meningkat secara cepat.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 22
          }
        },
        {
          "type": "Paragraph",
          "text": "Pasien bisa merasa bingung dan sulit konsentrasi, takikardi, palpitasi, berkeringat, rasa takut yang hebat akan ancaman kematian atau bencana.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 23
          }
        },
        {
          "type": "Paragraph",
          "text": "Kesulitan bicara seperti gagap dan gangguan memori.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 24
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 20
      },
      "recommended_pages": [
        4,
