    {
      "id": "batch_2_6f_02_s12",
      "title": "Psikoterapi utama yang direkomendasikan untuk penanganan gangguan panik adalah Cognitive Behavioura….",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "CBT digunakan untuk mengatasi pikiran-pikiran disfungsional mengenai gejala fisik yang dialami dan sekaligus mengatasi perilaku menghindar yang dialami oleh pasien.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 56
          }
        },
        {
          "type": "Paragraph",
          "text": ".Tujuan dari CBT adalah membantu pasien untuk menghadapi gejala-gejala kecemasan tanpa mengalami serangan panik. CBT juga bertujuan mengubah pikiran disfungsional mengenai kecemasan menjadi pikiran bahwa kecemasan adalah respon normal ketika menghadapi ketidakpastian.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 57
          }
        },
        {
          "type": "Paragraph",
          "text": "“.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 59
          }
        },
        {
          "type": "Paragraph",
          "text": "Tujuan utama penatalaksanaan adalah untuk menurunkan intensitas, frekuensi, dan durasi serangan panik; mengurangi perilaku menghindar, mencegah relapse, dan memperbaiki kualitas hidup.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 60
          }
        }
      ],
      "provenance": {
