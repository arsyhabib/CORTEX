    {
      "id": "batch_2_6f_01_s20",
      "title": "Terapi suportif adalah bentuk terapi alternatif yang.",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "Mempunyai tujuan antara lain untuk: .",
          "provenance": {
