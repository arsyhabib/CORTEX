    {
      "id": "batch_2_6f_01_s02",
      "title": "GANGGUAN ANSIETAS & PENATALAKSANAANNYA.",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "By: dr. Susiati, M.Ked, Sp.K.J.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 3
          }
        },
        {
          "type": "Paragraph",
          "text": "Kecemasan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 5
          }
        },
        {
          "type": "Paragraph",
          "text": "Ansietas: rasa takut yang tersamar, tidak.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 6
          }
        },
        {
          "type": "Paragraph",
          "text": "Menyenangkan, menyebar, konfliktual, sering disertai.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 7
          }
        },
        {
          "type": "Paragraph",
          "text": "Oleh gejala-gejala otonomik seperti dada berdebar-.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 8
          }
        },
        {
          "type": "Paragraph",
          "text": "Debar, berkeringat, sesak nafas, ketegangan otot, sakit.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 9
          }
        },
        {
          "type": "Paragraph",
          "text": "Kepala, serta tampak disertai dengan kegelisahan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 10
          }
        },
        {
          "type": "Paragraph",
          "text": "Individual.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 11
          }
        },
        {
          "type": "Paragraph",
          "text": "Ansietas juga dapat didefinisikan sebagai suatu.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 12
          }
        },
        {
          "type": "Paragraph",
          "text": "Respon yang normal dan adaptif terhadap ancaman.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 13
          }
        },
        {
          "type": "Paragraph",
          "text": "Yang menyiapkan organisme tersebut untuk fight atau.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 14
          }
        }
      ],
