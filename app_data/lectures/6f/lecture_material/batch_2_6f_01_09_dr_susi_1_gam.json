    {
      "id": "batch_2_6f_01_s06",
      "title": "GANGGUAN ANSIETAS MENYELURUH (GAM).",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "GAM ini sulit dikendalikan dan dikaitkan dengan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 39
          }
        },
        {
          "type": "Table",
          "rows": [
            [
              "Cemas yang berlebihan",
              "Gejala somatik, seperti ketegangan otot, mudah marah, kesulitan tidur, dan kegelisahan."
            ]
          ],
          "provenance": {
            "source_kind": "Docx_table",
            "table_index": 40
          }
        },
        {
          "type": "Paragraph",
          "text": "Pasien dengan GAM biasanya mencari dokter umum karena membantu keluhan somatik, atau datang ke dokter spesialis karena gejala spesifik seperti diare kronis.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 41
          }
        },
        {
          "type": "Paragraph",
          "text": "GAM bukan disebabkan oleh penggunaan zat atau kondisi medis umum, dan tidak terjadi selama gangguan-gangguan psikiatri atau mood.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 42
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 37
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_01_s07",
      "title": "DEFINISI",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "Gangguan ansietas menyeluruh adalah gangguan ansietas kronis yang ditandai dengan kekhawatiran yang berlebihan, sulit dikendalikan, menyeluruh dan menetap, yang disertai dengan gejala-gejala somatik dan psikis.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 45
          }
        },
        {
          "type": "Paragraph",
          "text": "GAM juga merupakan kondisi gangguan yang ditandai dengan kecemasan/kekhawatiran yang berlebihan, tidak rasional bahkan tidak realistik terhadap berbagai peristiwa kehidupan sehari- hari.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 46
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 44
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_01_s08",
      "title": "GAMBARAN KLINIS",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "Kecemasan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 49
          }
        },
        {
          "type": "Paragraph",
          "text": "Gejala utama GAM → ansietas, ketegangan motorik (kedutan otot atau rasa gemetar; otot tegang/kaku/pegal linu; tidak bisa diam; mudah menjadi lelah), hiperaktivitas otonom (nafas pendek/terasa berat; jantung berdebar-debar; telapak tangan basah-dingin; mulut kering; kepala pusing/rasa melayang; mual, mencret, perut tak enak; muka panas/badan menggigil; b.a.k lebih sering, sukar menelan/rasa tersumbat),.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 50
          }
        },
        {
          "type": "Paragraph",
          "text": "Kesiagaan yang ber>> (cth perasaan jadi.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 52
          }
        },
        {
          "type": "Paragraph",
          "text": "Peka/sensitif seperti mudah terkejut, mudah.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 53
          }
        },
        {
          "type": "Paragraph",
          "text": "Tersinggung, sukar tidur) dan kognitif.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 54
          }
        },
        {
          "type": "Table",
          "rows": [
            [
              "Berkurang.",
              "Kosentrasi bisa mengganggu"
            ]
          ],
          "provenance": {
            "source_kind": "Docx_table",
            "table_index": 55
          }
        },
        {
          "type": "Paragraph",
          "text": "Ansietas pada GAM tadi berlebihan dan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 56
          }
        },
        {
          "type": "Paragraph",
          "text": "Mengganggu aspek-aspek kehidupan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 57
          }
        },
        {
          "type": "Paragraph",
          "text": "Gejala2 GAM.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 59
          }
        },
        {
          "type": "Paragraph",
          "text": "Kegelisahan, kelelahan,.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 60
          }
        },
        {
          "type": "Paragraph",
          "text": "Kekhawatiran berlebih, nyeri.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 61
          }
        },
        {
          "type": "Paragraph",
          "text": "Otot, kosentrasi terganggu,.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 62
          }
        },
        {
          "type": "Paragraph",
          "text": "Irritable, gangguan tidur.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 63
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 48
      },
      "recommended_pages": [
        4,
        9
      ]
    },
