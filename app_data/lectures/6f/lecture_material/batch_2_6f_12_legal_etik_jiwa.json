          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 116
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Gagal mendiagnosa.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 117
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Masalah terkait dengan ECT.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 118
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Penyalahgunaan obat-obat Psikoaktif.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 119
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Melanggar kerahasiaan.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 120
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Gagal merujuk pasien.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 121
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Gagal untuk melaporkan penganiyaan.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 122
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Tidak adanya informed consent.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 123
          }
        },
        {
          "type": "Paragraph",
          "text": "Pertanggungjawaban Pidana terkait dengan kondisi jiwa seseorang.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 124
          }
        },
        {
          "type": "Paragraph",
          "text": "Tindakan kriminal yang dilakukan oleh seseorang yang diduga memiliki kelainan jiwa perlu mendapatkan penyelididkan dari seorang ahli kesehatan jiwa (Visum et repertum psikiatrikum; VER).",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 125
          }
        },
        {
          "type": "Paragraph",
          "text": "Argumen yang menyebutkan bahwa seseorang yang didakwa melakukan tindakan kriminal dianggap tidak bersalah karena orang tersebut tidak bisa mengontrol perbuatannya atau tidak mengerti perbedaan antara benar dan salah yang dikenal sebagai Peraturan M’Naghten.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 126
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Saat orang tersebut memenuhi kriteria, dia.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 127
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 115
      },
      "recommended_pages": [
        4,
