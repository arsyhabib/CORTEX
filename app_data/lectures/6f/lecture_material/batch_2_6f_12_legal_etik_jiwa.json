          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 79
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Menuntut nakes menghindari yg membahayakan pasien selama pemberian.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 80
          }
        },
        {
          "type": "Paragraph",
          "text": "Asuhan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 81
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Bekerja dg konsep dalin di RS.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 82
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Keadilan.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 83
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Merupakan suatu prinsip moral untuk berlaku adil terhadap semua.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 84
          }
        },
        {
          "type": "Paragraph",
          "text": "Pasien sesuai dengan kebutuhan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 85
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Setiap individu mendapat tindakan yg sama berarti mempunyai.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 86
          }
        },
        {
          "type": "Paragraph",
          "text": "Kontribusi yg relatif sama untuk kebaikan kehidupan seseorang.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 87
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Kejujuran, Kerahasiaan.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 88
          }
        },
        {
          "type": "Paragraph",
          "text": "Dan Kesetiaan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 89
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Kejujuran adalah kewajiban untuk mengungkapkan yg sebenarnya atau tdk.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 90
          }
        },
        {
          "type": "Paragraph",
          "text": "Membohongi pasien didasarkan pd hub saling percaya.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 91
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Kerahasiaan adalah kewajiban untuk melindungi informasi rahasia.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 92
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Kesetiaan adalah kewajiban untuk menepati janji.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 93
          }
