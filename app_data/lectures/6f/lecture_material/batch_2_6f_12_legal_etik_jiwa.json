    {
      "id": "batch_2_6f_12_s08",
      "title": "JIWA",
      "kind": "Reading",
      "content": [
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Pasien bunuh diri.",
              "children": []
            }
