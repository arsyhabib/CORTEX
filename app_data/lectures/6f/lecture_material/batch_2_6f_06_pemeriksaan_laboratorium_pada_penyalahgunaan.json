    {
      "id": "batch_2_6f_06_s02",
      "title": "Pemeriksaan Laboratorium pada Penyalahgunaan Obat Psikoaktif, NAPZA dan Alkohol.",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "Angka kejadian penyalahgunaan obat: .",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 14
          }
        },
        {
          "type": "Paragraph",
          "text": "USA: terutama gol sosek rendah.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 15
          }
        },
        {
          "type": "Paragraph",
          "text": "Laki > perempuan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 16
          }
        },
        {
          "type": "Paragraph",
          "text": "Kelompok pengangguran > kelompok bekerja.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 17
          }
        },
        {
          "type": "Paragraph",
          "text": "Pengguna medical professional >.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 18
          }
        },
        {
          "type": "Paragraph",
          "text": "Prevalensi paling tinggi pada usia 18 - 25 tahun.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 19
          }
        },
        {
          "type": "Paragraph",
          "text": "Trend penyalahgunaan obat di Indonesia relatif stabil: meliputi alkohol, sedatif- hipnotik (obat penenang), ganja, campuran serta sedikit morfin/heroin dan amfetamin.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 20
          }
        },
        {
          "type": "Paragraph",
          "text": "Opioid.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 21
          }
        },
        {
          "type": "Paragraph",
          "text": "Adalah segolongan zat yang mempunyai khasiat seperti morfin.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 22
          }
        },
        {
          "type": "Paragraph",
          "text": "Mempunyai khasiat: - analgesik.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 23
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Hipnotik (menidurkan).",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 24
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Euforia(gembira/nikmat).",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 25
          }
        }
      ],
