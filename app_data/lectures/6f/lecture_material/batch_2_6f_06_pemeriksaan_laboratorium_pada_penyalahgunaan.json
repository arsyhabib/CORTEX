    {
      "id": "batch_2_6f_06_s03",
      "title": "Pemeriksaan Laboratorium pada Penyalahgunaan Obat Psikoaktif, NAPZA dan Alkohol.",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "Alkohol.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 26
          }
        },
        {
          "type": "Paragraph",
          "text": "Minuman yang mengandung etanol.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 27
          }
        },
        {
          "type": "Paragraph",
          "text": "Bir berkadar alkohol 2 - 5%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 28
          }
        },
        {
          "type": "Paragraph",
          "text": "Anggur berkadar alkohol 10 - 14%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 29
          }
        },
        {
          "type": "Paragraph",
          "text": "Wiski, vodka, brendi berkadar alkohol 40 -.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 30
          }
        },
        {
          "type": "Paragraph",
          "text": "50%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 31
          }
        },
        {
          "type": "Paragraph",
          "text": "Ganja.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 32
          }
        },
        {
          "type": "Paragraph",
          "text": "Berasal dari tanaman kanabis: suatu tanaman yang mengandung zat psikoaktif delta-9-tetra- hidro-kanabinol (THC).",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 33
          }
        },
        {
          "type": "Paragraph",
          "text": "THC dapat dideteksi dalam urine sampai 1 mgg setelah penggunaan terakhir.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 34
          }
        },
        {
          "type": "Paragraph",
          "text": "Pengaruh ganja melalui rokok timbul setelah 20 -.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 35
          }
        },
        {
          "type": "Paragraph",
          "text": "30 menit dan bertahan 2 - 4 jam.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 36
          }
        },
        {
          "type": "Paragraph",
          "text": "Sedatif-hipnotik.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 37
          }
        }
      ],
      "recommended_pages": [
        4,
        9
      ],
