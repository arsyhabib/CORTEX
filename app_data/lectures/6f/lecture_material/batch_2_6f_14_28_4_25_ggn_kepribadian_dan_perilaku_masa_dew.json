    {
      "id": "batch_2_6f_14_s06",
      "title": "EPIDEMIOLOGI",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "■ Gangguan Kepribadian.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 43
          }
        },
        {
          "type": "Paragraph",
          "text": "■ Paranoid 0, 5% - 2, 5% pada populasi umum ■ Skizoid uncommon.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 44
          }
        },
        {
          "type": "Paragraph",
          "text": "■ Skizotipal 3%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 45
          }
        },
        {
          "type": "Paragraph",
          "text": "■ Antisosial laki-laki 3%; perempuan 1%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 46
          }
        },
        {
          "type": "Paragraph",
          "text": "Meningkat pada penyalahguna zat.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 47
          }
        },
        {
          "type": "Paragraph",
          "text": "Dan di penjara.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 48
          }
        },
        {
          "type": "Paragraph",
          "text": "■ Borderline 2%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 49
          }
        },
        {
          "type": "Paragraph",
          "text": "■ Histrionik 2% - 3%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 50
          }
        },
        {
          "type": "Paragraph",
          "text": "■ Narsisistik < 1%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 51
          }
        },
        {
          "type": "Paragraph",
          "text": "■ Menghindar 0, 5% - 1%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 52
          }
        },
        {
          "type": "Paragraph",
          "text": "■ Dependen 2, 5% - 25%.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 53
          }
        },
        {
          "type": "Paragraph",
          "text": "■ Obsesif-Kompulsif 1% 7.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 54
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 42
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s07",
      "title": "PARANOID",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "Curiga -- Dendam.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 57
          }
        },
        {
          "type": "Paragraph",
          "text": "Sedikitnya terdapat 3 gejala tersebut dibawah ini ◘ Sangat peka thdp kegagalan dan penolakan. ◘ Kecenderungan tetap menyimpan dendam, sulit memaafkan walau itu masalah kecil.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 58
          }
        },
        {
          "type": "Paragraph",
          "text": "◘ Kecurigaan thdp sikap netral orang lain, merasa ini sbg sikap bermusuhan atau penghinaan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 59
          }
        },
        {
          "type": "Paragraph",
          "text": "◘ Perasaan bermusuhan dan ngotot.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 61
          }
        },
        {
          "type": "Paragraph",
          "text": "Mempertahankan hak pribadi tanpa.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 62
          }
        },
        {
          "type": "Paragraph",
          "text": "Memperhatikan situasi dgn gigih atau dgn kekuatan fisik.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 63
          }
        },
        {
          "type": "Paragraph",
          "text": "◘ Kecurigaan berulang tanpa dasar, ttg kesetiaan seksual pasangannya.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 64
          }
        },
        {
          "type": "Paragraph",
          "text": "◘ Kecenderungan merasa dirinya penting secara berlebihan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 65
          }
        },
        {
          "type": "Paragraph",
          "text": "◘ Merasa ada persekongkolan thdp dirinya.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 66
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 56
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s08",
      "title": "GGAN KEPRIBADIAN SKIZOID Introvert parah.",
      "kind": "Reading",
      "content": [
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Tidak ada atau hanya sedikit aktivitas yg menimbulkan rasa bahagia.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 69
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Emosi dingin, afek datar atau tidak peduli Kurang mampu mengekspresikan kehangatan, kelembutan atau, kemarahan terhadap orang lain. Nyata ketidakpedulian thdp kecaman atau pujian.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 70
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Tidak tertarik untuk menjalin pengalaman seksual dgn orang lain.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 72
          }
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Selalu memilih aktivitas menyendiri. Dirundung fantasi dan introspeksi yg >>. Tidak mempunyai teman akrab/dekat. Tidak sensitif thdp norma kebiasaan sosial yg berlaku.",
              "children": []
            }
          ],
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 73
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 68
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s09",
      "title": "SKIZOTIPAL",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "> Punya indera ke-6 -.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 77
          }
        },
        {
          "type": "Paragraph",
          "text": "Suka liat yg arch?",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 78
          }
        },
        {
          "type": "Paragraph",
          "text": "◙ Dijumpai keanehan dalam berpikir, perilaku dan penampilan (eksentrik).",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 79
          }
        },
        {
          "type": "Paragraph",
          "text": "◙ Gagasan yg menyangkut diri sendiri (ideas of reference).",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 80
          }
        },
        {
          "type": "Paragraph",
          "text": "◙ Keyakinan yg aneh dan pikiran magis. ◙ Pikiran paranoid atau curiga.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 81
          }
        },
        {
          "type": "Paragraph",
          "text": "◙ Tidak memiliki teman akrab atau orang yg dipercaya kecuali keluarga setingkat. ◙ Afek tidak sesuai atau terbatas.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 83
          }
        },
        {
          "type": "Paragraph",
          "text": "◙ Ada ilusi perseptual berupa mikropsia atau melihat orang seperti kayu atau jadi2an.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 84
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 76
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s10",
      "title": "SOSIAL",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": ">Kriminal.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 88
          }
        },
        {
          "type": "Paragraph",
          "text": "Sering dipenjara.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 90
          }
        },
        {
          "type": "Paragraph",
          "text": "◊ Gagal mematuhi norma sosial yg sesuai hukum secara berulang sering dipenjara.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 91
          }
        },
        {
          "type": "Paragraph",
          "text": "◊ Tidak jujur, sering bohong, menggunakan nama samaran, menipu unt kesenangan pribadi. ◊ Impulsif, tanpa rencana unt masa depan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 92
          }
        },
        {
          "type": "Paragraph",
          "text": "◊ Mengabaikan keselamatan diri sendiri dan orang lain (sembrono).",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 94
          }
        },
        {
          "type": "Paragraph",
          "text": "◊ Perilaku tidak bertanggung jawab.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 95
          }
        },
        {
          "type": "Paragraph",
          "text": "◊ Tidak ada penyesalan, acuh tak acuh, mencari alasan tlh disakiti a’ dianiaya orang lain.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 96
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 87
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s11",
      "title": "BORDERLINE/AMBANG",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "☺ Ggan ini berada pd perbatasan antara neurosis dan psikosis.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 100
          }
        },
        {
          "type": "Paragraph",
          "text": "☺ Afek, mood, perilaku, hubungan inter personal, citra diri sangat tidak stabil.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 101
          }
        },
        {
          "type": "Paragraph",
          "text": "☺ Impulsive terhadap berbelanja, seks, penya lahgunaan zat, ngebut, pesta2.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 102
          }
        },
        {
          "type": "Paragraph",
          "text": "☺ Perilaku isyarat atau ancaman bunuh diri yg berulang kali, mutilasi diri.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 104
          }
        },
        {
          "type": "Paragraph",
          "text": "☺ Marah yg timbul tidak pada tempatnya. ☺ Ada ide paranoid.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 105
          }
        },
        {
          "type": "Paragraph",
          "text": "☺ Perilaku sangat tidak dapat diramalkan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 106
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 99
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s12",
      "title": "HISTRIONIK",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "> Pick Me -.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 110
          }
        },
        {
          "type": "Paragraph",
          "text": "Pick me.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 111
          }
        },
        {
          "type": "Paragraph",
          "text": "☼ Perilaku bermacam-macam, dramatik, ekstrovert dan emosional.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 112
          }
        },
        {
          "type": "Paragraph",
          "text": "☼ Insiden wanita > laki2.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 113
          }
        },
        {
          "type": "Paragraph",
          "text": "☼ Perilaku mencari perhatian yg tinggi, membuat segalanya terdengar lebih penting dibanding kenyataannya.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 114
          }
        },
        {
          "type": "Paragraph",
          "text": "☼ Tidak merasa nyaman kalau tidak menjadi pusat perhatian.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 116
          }
        },
        {
          "type": "Paragraph",
          "text": "☼ Mudah disugesti atau mudah dipengaruhi oleh orang lain.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 117
          }
        },
        {
          "type": "Paragraph",
          "text": "☼ MPE utamanya adalah represi dan disosiasi.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 118
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 109
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s13",
      "title": "NARSISISTIK",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "□ Ditandai dgn meningkatnya rasa kepentingan diri dan perasaan kebesaran yg unik.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 122
          }
        },
        {
          "type": "Paragraph",
          "text": "□ Menganggap dirinya khusus, tidak mampu unt dikritik atau tidak perduli terhadap kritik. □ Tidak mampu menunjukkan empati, hanya berpura-pura simpati hanya unt mencapai kepentingan mereka sendiri.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 123
          }
        },
        {
          "type": "Paragraph",
          "text": "□ Selalu memanfaatkan orang lain, harga diri yg rapuh dan rentan terhadap depresi.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 125
          }
        },
        {
          "type": "Paragraph",
          "text": "□ Ggan kepri. ambang, histrionik dan anti sosial sering bersama-sama dgn ggan ini.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 126
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 121
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s14",
      "title": "MENGHINDAR",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "∞ Individu ini menunjukkan kepekaan yg ekstrem terhadap penolakan, yg dapat menyebabkan penarikan diri dari kehidupan sosial.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 130
          }
        },
        {
          "type": "Paragraph",
          "text": "∞ Mereka ingin berteman tetapi malu, memer-lukan jaminan unt penerimaan tanpa kritikan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 131
          }
        },
        {
          "type": "Paragraph",
          "text": "∞ Menunjukkan keterbatasan dalam hubungan intim karena rasa takut dipermalukan atau.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 132
          }
        },
        {
          "type": "Paragraph",
          "text": "Ditertawakan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 133
          }
        },
        {
          "type": "Paragraph",
          "text": "∞ Memandang diri sendiri rendah, tidak menarik dan lebih rendah dari orang lain.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 135
          }
        },
        {
          "type": "Paragraph",
          "text": "∞ Tidak berani mengambil resiko.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 136
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 129
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s15",
      "title": "DEPENDEN",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "╩ Individu ini menempatkan kebutuhan mereka sendiri dibawah kebutuhan orang lain, meminta orang lain unt mengambil tanggung jawab unt masalah besar dalam hidupnya, tdk punya percaya diri.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 140
          }
        },
        {
          "type": "Paragraph",
          "text": "╩ Ada perilaku ketergantungan. Dan sikap patuh yg berlebihan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 141
          }
        },
        {
          "type": "Paragraph",
          "text": "╩ Orang ini akan menjadi cemas jika diminta unt memegang peran kepemimpinan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 143
          }
        },
        {
          "type": "Paragraph",
          "text": "╩ Tidak senang sendirian, mereka mencari orang lain pada siapa mereka dapat menggantung.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 144
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 139
      },
      "recommended_pages": [
        4,
        9
      ]
    },
    {
      "id": "batch_2_6f_14_s16",
      "title": "GGAN KEPRIBADIAN OBSESIF KOMPULSIF.",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "✔ Ditandai dgn penyempitan emosi, ketertiban, kekerasan hati, sikap keras kepala dan kebimbangan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 147
          }
        },
        {
          "type": "Paragraph",
          "text": "✔ Insiden laki2 > wanita.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 148
          }
        },
        {
          "type": "Paragraph",
          "text": "✔ Selalu ingin terlihat sempurna orangnya menjadi serius, resmi dan tidak mempunyai rasa humor.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 149
          }
        },
        {
          "type": "Paragraph",
          "text": "✔ Memaksakan aturan supaya diikuti secara kaku dan tidak mampu unt mentolerir apa yg dirasakan sebagai pelanggaran.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 151
          }
        },
        {
          "type": "Paragraph",
          "text": "✔ Kikir, menimbun uang unt bencana dimasa depan.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 152
          }
        }
      ],
      "provenance": {
        "source_kind": "Docx_text",
        "paragraph_index": 146
      },
      "recommended_pages": [
