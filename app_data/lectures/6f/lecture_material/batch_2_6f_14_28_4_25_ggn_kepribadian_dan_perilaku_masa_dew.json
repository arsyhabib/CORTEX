    {
      "id": "batch_2_6f_14_s05",
      "title": "JENIS-JENIS GANGGUAN KEPRIBADIAN",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "F60. Gangguan Kepribadian Khas ⮚ F60.0. GP Paranoid.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 29
          }
        },
        {
          "type": "Paragraph",
          "text": "F60.1. GP Skizoid.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 30
          }
        },
        {
          "type": "Paragraph",
          "text": "F60.2. GP Dissosial.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 31
          }
        },
        {
          "type": "Paragraph",
          "text": "F60.3. GP Emosional tak stabil ⮚ F60.4. GP Histrionik.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 32
          }
        },
        {
          "type": "Paragraph",
          "text": "F60.5. GP Anankastik.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 33
          }
        },
        {
          "type": "Paragraph",
          "text": "F60.6. GP Cemas (mengindar) ⮚ F60.7. GP Dependen.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 34
          }
        },
        {
          "type": "Paragraph",
          "text": "F60.8. GP Khas Lainnya ⮚ F60.9. GP YTT.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 35
          }
        },
        {
          "type": "Paragraph",
          "text": "F61. Gangguan Kepribadian Campuran dan lainnya.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 36
          }
        },
        {
          "type": "Paragraph",
          "text": "F61.0. GP campuran.",
          "provenance": {
            "source_kind": "Docx_text",
            "paragraph_index": 37
          }
        },
        {
          "type": "Paragraph",
          "text": "F61.1. Perubahan kepribadian yang bermasalah.",
          "provenance": {
