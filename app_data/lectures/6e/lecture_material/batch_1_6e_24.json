    {
      "id": "batch_1_6e_24_s03",
      "title": "Typical locations:",
      "kind": "Reading",
      "content": [
        {
          "type": "Paragraph",
          "text": "Ganglia basal, thalamus, cerebellum dan brain stem (pons).",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 25,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "ICH karena hypertensi sering karena ruptur yang berukuran 50-200milimikron dari a lenticulostriata cabang arteri cerebri media ke putamen, nucleus caudatus.",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 28,
                "style": "Normal"
              },
              "confidence": "high"
            },
            {
              "text": "Dapat juga ruptur dari cababg a Basilaris ke.",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 29,
                "style": "Normal"
              },
              "confidence": "high"
            }
          ],
          "source_document": "stroke-dr.Erni Z, SpRad.docx"
        },
        {
          "type": "Paragraph",
          "text": "Pontine atau thalamus.",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 30,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Paragraph",
          "text": "GOAL of Imaging Hemorrhagic.",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 35,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Mengetahuai adanya perdarahan.",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 36,
                "style": "Normal"
              },
              "confidence": "high"
            },
            {
              "text": "Lokasi perdarahan: Intra vs ekstra aksial,.",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 37,
                "style": "Normal"
              },
