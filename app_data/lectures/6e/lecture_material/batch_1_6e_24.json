    {
      "id": "batch_1_6e_24_s04",
      "title": "Gambaran CT",
      "kind": "Image",
      "content": [
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Berdasarkan atenuasi X ray terhadap protein HB (relatif mendekati konsentrasi plasma).",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 49,
                "style": "Normal"
              },
              "confidence": "high"
            }
          ],
          "source_document": "stroke-dr.Erni Z, SpRad.docx"
        },
        {
          "type": "Paragraph",
          "text": "Hiperacut.",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 54,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Beberapa saat setelah ruptur pembuluh darah, hematom terdiri dari erytrocit, leucocyt, protein dalam sel dan platelet memberikan gambaran yang heterogen atenuasi 30- 60HU, tergantung plasma yang terlepas.",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 55,
                "style": "Normal"
              },
              "confidence": "high"
            }
          ],
          "source_document": "stroke-dr.Erni Z, SpRad.docx"
        },
        {
          "type": "Paragraph",
          "text": "Atenuasi hampir sama dengan atenuasi corteks (kadang sulit dibedakan).",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 56,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Paragraph",
          "text": "Acut.",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 61,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Beberapa menit hingga jam terbentuk fibrin.",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 62,
                "style": "Normal"
              },
              "confidence": "high"
            }
          ],
          "source_document": "stroke-dr.Erni Z, SpRad.docx"
        },
        {
          "type": "Paragraph",
          "text": "Atenuasi 60-80 HU.",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 63,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Paragraph",
          "text": "Subacut.",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 64,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Paragraph",
          "text": "Terjadi clot retraksi dan lepasnya serum.",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 65,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Paragraph",
          "text": "Atenuasi 80-100 HU ditengah hematom.",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 66,
            "style": "Normal"
          },
          "confidence": "high"
        },
        {
          "type": "Bullet_group",
          "items": [
            {
              "text": "Vasogenik edema terjadi disekitar hematom terjadi beberapa jam dan berlanjut bertambah sampai hingga 2 minggu setelah onset.",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 71,
                "style": "Normal"
              },
              "confidence": "high"
            },
            {
              "text": "Setelah beberapa hari sel2 dan protein pecah dan di bersihkan o/ makrophag, lambat laun atenuasi berkurang secara gradual mulai dari perifer hematom menuju sentral.",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 72,
                "style": "Normal"
              },
              "confidence": "high"
            },
            {
              "text": "+/- 9 hari atenuasi menurun spt corteks, 2-3.",
              "children": [],
              "provenance": {
                "source_document": "stroke-dr.Erni Z, SpRad.docx",
                "source_paragraph_index": 73,
                "style": "Normal"
              },
              "confidence": "high"
            }
          ],
          "source_document": "stroke-dr.Erni Z, SpRad.docx"
        },
        {
          "type": "Paragraph",
          "text": "Minggu spt white matter.",
          "provenance": {
            "source_document": "stroke-dr.Erni Z, SpRad.docx",
            "source_paragraph_index": 74,
            "style": "Normal"
          },
          "confidence": "high"
        }
      ],
