{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORTEX Content Link Map",
  "type": "object",
  "required": ["links"],
  "properties": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_id", "to_id", "link_type"],
        "properties": {
          "from_id": { "type": "string" },
          "to_id": { "type": "string" },
          "link_type": {
            "type": "string",
            "enum": ["material_to_question", "question_to_material", "material_to_visual", "question_to_glossary", "set_to_page"]
          },
          "strength": {
            "type": "string",
            "enum": ["strong", "medium", "weak"]
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}

