{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORTEX Original Exam Set",
  "type": "object",
  "required": ["id", "title", "block", "year", "source_label", "questions"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "block": {
      "type": "string",
      "enum": ["5e", "5f", "mixed"]
    },
    "year": { "type": "integer" },
    "year_label": { "type": "string" },
    "source_label": { "type": "string" },
    "page_route": { "type": "string" },
    "question_count": { "type": "integer" },
    "reconstruction_level": {
      "type": "string",
      "enum": ["verbatim", "near_verbatim", "reconstructed", "inferred"]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "stem", "options"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "integer" },
          "stem": { "type": "string" },
          "stem_original": { "type": "string" },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          },
          "answer_index": { "type": "integer" },
          "answer_text": { "type": "string" },
          "explanation": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "origin": {
            "type": "object",
            "properties": {
              "page": { "type": "integer" },
              "page_label": { "type": "string" },
              "is_reconstructed": { "type": "boolean" }
            }
          },
          "linked_material_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}

