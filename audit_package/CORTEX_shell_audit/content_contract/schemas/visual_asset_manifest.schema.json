{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORTEX Visual Asset Manifest",
  "type": "object",
  "required": ["assets"],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "domain", "src"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "domain": { "type": "string" },
          "src": { "type": "string" },
          "poster": { "type": "string" },
          "alt": { "type": "string" },
          "caption": { "type": "string" }
        }
      }
    }
  }
}

