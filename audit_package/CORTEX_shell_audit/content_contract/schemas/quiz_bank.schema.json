{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORTEX Quiz Bank",
  "type": "object",
  "required": ["quizzes"],
  "properties": {
    "quizzes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "domain", "question", "options", "answer_index"],
        "properties": {
          "id": { "type": "string" },
          "domain": { "type": "string" },
          "linked_content_id": { "type": "string" },
          "question": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          },
          "answer_index": { "type": "integer" },
          "explanation": { "type": "string" }
        }
      }
    }
  }
}

