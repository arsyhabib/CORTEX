{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORTEX Lecture Material",
  "type": "object",
  "required": ["id", "block", "title", "source_pdf", "sections"],
  "properties": {
    "id": { "type": "string" },
    "block": {
      "type": "string",
      "enum": ["5e", "5f", "5e/5f", "shared"]
    },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "source_pdf": { "type": "string" },
    "source_pages": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "summary": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exam_focus": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "content"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["reading", "bullet", "callout", "table", "image", "media", "bilingual", "summary"]
          },
          "content": {
            "type": "array"
          },
          "visual_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "quiz_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "glossary_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "question_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "related_exam_set_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

