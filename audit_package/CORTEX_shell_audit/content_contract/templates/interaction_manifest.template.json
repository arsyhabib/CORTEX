{
  "haptics": {
    "enabled_default": true,
    "mode_default": "auto",
    "intensity_default": "balanced",
    "long_press_ms_default": 500
  },
  "long_press_actions": [
    {
      "target_type": "content_card",
      "actions": ["bookmark", "highlight", "explain_simpler"]
    },
    {
      "target_type": "image_card",
      "actions": ["open_media_viewer", "copy_caption"]
    },
    {
      "target_type": "quiz_option",
      "actions": ["mark_doubtful", "show_hint"]
    }
  ]
}

